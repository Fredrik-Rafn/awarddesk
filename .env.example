# Optional first-run import: copy to .env before starting a new workspace.
# After import, manage these values in /admin; SQLite is authoritative.
HYPER_API_KEY=
ANYSOLVER_API_KEY=
AWARDDESK_PROXY_FILE=proxies.txt
EVA_EMAIL=
EVA_PASSWORD=
OUTLOOK_EMAIL=
OUTLOOK_CLIENT_ID=
OUTLOOK_REFRESH_TOKEN=
EVA_BACKGROUND_ENABLED=true
EVA_IMPERVA_SOLVER=auto
EVA_RESULT_CACHE_TTL=30m
SEARCH_CONCURRENCY=30

# Demo startup variables must be exported in the terminal, not set in this file.
# See docs/demo.md or use start-demo.ps1 on Windows.
