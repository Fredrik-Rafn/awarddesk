# Optional FIRST-RUN import: copy to .env before launching a new workspace.
# After migration, SQLite is authoritative; use /admin for EVA/settings changes.
HYPER_API_KEY=
ANYSOLVER_API_KEY=
# Keep proxy credentials out of Git.
AWARDDESK_PROXY_FILE=proxies.txt
EVA_EMAIL=
EVA_PASSWORD=
OUTLOOK_EMAIL=
OUTLOOK_CLIENT_ID=
OUTLOOK_REFRESH_TOKEN=
# Optional: set false to disable startup/periodic preparation for that airline.
EVA_BACKGROUND_ENABLED=true
# Booking security: Hyper first; AnySolver backup for service-generation errors.
# hyper and anysolver force one provider for diagnostics.
EVA_IMPERVA_SOLVER=auto
# Reuse complete identical searches for this long. 0s disables result caching.
EVA_RESULT_CACHE_TTL=30m
# These files are imported only on the first run. Use /admin afterwards.
